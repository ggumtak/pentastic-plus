<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 앱 안에서 새 버전을 받아 설치 (설정 > 앱 업데이트) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- 펜 버튼 길게 누르기(에어 액션)로 실행되는 진입점. 화면 없이 캡처만 요청하고 바로 닫힌다. -->
        <activity
            android:name=".TriggerActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- AI 챗: 분할 화면으로 Anki 옆에 띄워 두는 대화 화면. 앱 서랍/작업 표시줄에서 끌어 분할 화면에 놓을 수 있게 아이콘을 따로 둔다. -->
        <activity
            android:name=".ChatActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/chat_name"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:taskAffinity="com.ggumtak.pentastic.chat"
            android:theme="@style/ChatTheme"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title"
            android:taskAffinity="com.ggumtak.pentastic.settings" />

        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false" />

        <service
            android:name=".CaptureService"
            android:exported="true"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
